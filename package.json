{
  "name": "dsh-wechat-md",
  "version": "0.1.0",
  "description": "WeChat Official Account (公众号) markdown editor as a DSH right-sidebar tab, sharing the article .md files with the chat agent.",
  "license": "MIT",
  "author": "haodong <81413790+dongdonga11@users.noreply.github.com>",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "wechat",
    "公众号",
    "markdown",
    "editor"
  ],
  "homepage": "https://github.com/dongdonga11/dsh-wechat-md#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dongdonga11/dsh-wechat-md.git"
  },
  "bugs": {
    "url": "https://github.com/dongdonga11/dsh-wechat-md/issues"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-isolation=none --test-timeout=30000 test/client.smoke.test.mjs test/client.unit.test.mjs test/routes.test.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "*",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar-right": {
      "optional": true
    }
  }
}
